#!/usr/bin/env python3
"""Stands in for `claude plugin ...` in tests: logs each call and edits the current folder's
.claude/settings.local.json the way the real CLI does for --scope local (seen in the 2026-11-21 spike), or the user
settings.json (in $CLAUDE_CONFIG_DIR, else ~/.claude) for --scope user (seen in the 2026-11-25 probe)."""
import json, os, sys
from pathlib import Path

with open(os.environ["FAKE_CLAUDE_LOG"], "a") as log:
    log.write(" ".join(sys.argv[1:]) + "\n")
p = Path.cwd() / ".claude" / "settings.local.json"
if "--scope" in sys.argv and sys.argv[sys.argv.index("--scope") + 1] == "user":
    p = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "settings.json"
s = json.loads(p.read_text()) if p.exists() else {}
a = sys.argv[1:]
if a[:3] == ["plugin", "marketplace", "add"]:
    path = a[3]
    name = json.loads((Path(path) / ".claude-plugin" / "marketplace.json").read_text())["name"]
    s.setdefault("extraKnownMarketplaces", {})[name] = {"source": {"source": "directory", "path": path}}
elif a[:2] == ["plugin", "install"]:
    # Like the real CLI (seen 2026-11-22): installing reads the marketplace at its recorded path.
    market = a[2].split("@")[1]
    source = s.get("extraKnownMarketplaces", {}).get(market, {}).get("source", {}).get("path", "")
    if not (Path(source) / ".claude-plugin" / "marketplace.json").exists():
        sys.exit(f'Failed to install plugin "{a[2]}": not found in marketplace "{market}"')
    s.setdefault("enabledPlugins", {})[a[2]] = True
elif a[:2] == ["plugin", "uninstall"]:
    s.get("enabledPlugins", {}).pop(a[2], None)
else:
    sys.exit(f"fake_claude: unexpected call {a}")
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(json.dumps(s, indent=2) + "\n")
