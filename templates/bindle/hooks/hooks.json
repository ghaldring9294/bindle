{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"", "timeout": 20 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/rules.sh\"", "timeout": 5 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.sh\"", "timeout": 30 } ] }
    ]
  }
}
