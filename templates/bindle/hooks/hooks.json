{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" session-start", "timeout": 20 },
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" rules", "timeout": 5 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" session-end", "timeout": 30 } ] }
    ]
  }
}
