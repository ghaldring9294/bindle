# --- Dispatch ----------------------------------------------------------------

DISPATCH = {
    "list": cmd_list,
    "doctor": cmd_doctor,
    "attach": cmd_attach,
    "detach": cmd_detach,
    "new": cmd_new,
    "global": cmd_global,
    "sync": cmd_sync,
    "update": cmd_update,
    "upgrade": cmd_upgrade,
    "promote": cmd_promote,
    "terms": cmd_terms,
    "collect": cmd_collect,
    "outbox_add": cmd_outbox_add,
    "outbox_list": cmd_outbox_list,
    "outbox_clean": cmd_outbox_clean,
    "outbox_remove": cmd_outbox_remove,
}


def build_args(name, a):
    """Create the argparse-like namespace each command function expects."""
    if name == "list":
        return SimpleNamespace(folder=a.get("folder"))
    if name == "doctor":
        return SimpleNamespace(folder=a.get("folder"))
    if name == "attach":
        return SimpleNamespace(bindle=a["bindle"], folder=a.get("folder"),
                               writable=a.get("writable", False), repos=a.get("repos", False))
    if name == "detach":
        return SimpleNamespace(bindle=a["bindle"], folder=a.get("folder"),
                               repos=a.get("repos", False))
    if name == "global":
        return SimpleNamespace(bindle=a["bindle"], off=a.get("off", False))
    if name == "new":
        return SimpleNamespace(name=a["name"], at=a.get("at"), sync=a.get("sync", False),
                               audience=a.get("audience", "private"), writes=a.get("writes", "implicit"))
    if name == "sync":
        return SimpleNamespace(folder=a.get("folder"), all=a.get("all", False))
    if name == "update":
        return SimpleNamespace(push=a.get("push", False), after_pull=False)
    if name == "upgrade":
        return SimpleNamespace(bindle=a.get("bindle"), all=a.get("all", False),
                               dry_run=a.get("dry_run", False))
    if name == "promote":
        return SimpleNamespace(source=a["source"], path=a.get("path"), into=a["into"], name=a["name"],
                               kind=a.get("kind", "memory"), description=a.get("description", ""),
                               allow=a.get("allow", []), replace=a.get("replace", False),
                               remove=a.get("remove", False), dry_run=a.get("dry_run", False))
    if name == "terms":
        return SimpleNamespace(bindle=a["bindle"], folder=a.get("folder"))
    if name == "collect":
        return SimpleNamespace(source=a["source"], into=a["into"], items=a.get("items"),
                               all=a.get("all", False), allow=a.get("allow", []),
                               dry_run=a.get("dry_run", False))
    if name == "outbox_add":
        return SimpleNamespace(bindle=a["bindle"], path=a["path"], name=a["name"],
                               kind=a.get("kind", "memory"), description=a.get("description", ""),
                               allow=a.get("allow", []))
    if name == "outbox_list":
        return SimpleNamespace(bindle=a.get("bindle"), all=a.get("all", False))
    if name == "outbox_clean":
        return SimpleNamespace(bindle=a["bindle"], items=a.get("items"),
                               dry_run=a.get("dry_run", False))
    if name == "outbox_remove":
        return SimpleNamespace(bindle=a["bindle"], items=a["items"],
                               dry_run=a.get("dry_run", False))
    raise BindleError(f"Unknown tool: {name}")


def call_tool(name, arguments):
    """Execute a bindle tool, capturing stdout as the result text."""
    fn = DISPATCH.get(name)
    if not fn:
        return {"content": [{"type": "text", "text": f"Unknown tool: {name}"}], "isError": True}
    old_stdout = sys.stdout
    sys.stdout = buf = io.StringIO()
    try:
        args = build_args(name, arguments or {})
        code = fn(args) or 0
        output = buf.getvalue()
        if code != 0 and not output:
            output = f"Command returned exit code {code}"
        return {"content": [{"type": "text", "text": output or "(no output)"}], "isError": code != 0}
    except BindleError as e:
        output = buf.getvalue()
        error_text = f"{output}\nbindle: {e}" if output else f"bindle: {e}"
        return {"content": [{"type": "text", "text": error_text}], "isError": True}
    except Exception as e:
        return {"content": [{"type": "text", "text": f"Internal error: {type(e).__name__}: {e}"}], "isError": True}
    finally:
        sys.stdout = old_stdout


# --- JSON-RPC / MCP protocol ------------------------------------------------

def respond(msg_id, result):
    sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": msg_id, "result": result}) + "\n")
    sys.stdout.flush()


def respond_error(msg_id, code, message):
    sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": msg_id,
                                 "error": {"code": code, "message": message}}) + "\n")
    sys.stdout.flush()


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue

        method = msg.get("method")
        msg_id = msg.get("id")

        if method == "initialize":
            respond(msg_id, {
                "protocolVersion": PROTOCOL_VERSION,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "bindle", "version": VERSION},
            })
        elif method == "notifications/initialized":
            pass
        elif method == "notifications/cancelled":
            pass
        elif method == "ping":
            respond(msg_id, {})
        elif method == "tools/list":
            respond(msg_id, {"tools": TOOLS})
        elif method == "tools/call":
            params = msg.get("params", {})
            result = call_tool(params.get("name"), params.get("arguments", {}))
            respond(msg_id, result)
        elif msg_id is not None:
            respond_error(msg_id, -32601, f"Method not found: {method}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
