#!/usr/bin/env python3
"""MCP server for bindle — exposes bindle operations as tools over JSON-RPC 2.0 / stdio.

Claude Code starts this when the bindle plugin is loaded (.mcp.json). Tools appear in every
session where the plugin is on. Standard library only; Python 3.9+.
"""
import io
import json
import os
import sys
from types import SimpleNamespace

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from bindle.core import VERSION, BindleError  # noqa: E402
from bindle.commands import (cmd_attach, cmd_detach, cmd_doctor, cmd_list,  # noqa: E402
                             cmd_new, cmd_sync)
from bindle.promote import (cmd_collect, cmd_outbox_add, cmd_outbox_clean,  # noqa: E402
                            cmd_outbox_list, cmd_outbox_remove, cmd_promote, cmd_terms)
from bindle.global_rules import cmd_global  # noqa: E402
from bindle.upgrade import cmd_update, cmd_upgrade  # noqa: E402

PROTOCOL_VERSION = "2024-11-05"

