#!/usr/bin/env python3
"""bindle: create bindles and turn them on for folders.

A bindle is one domain's layer (skills, hooks, memory, notes) in its own git repo, shaped as a
Claude Code plugin. A folder turns bindles on in its .claude/settings.local.json: every attached
bindle is on there, and at most one is writable (new memories land in its memory/ folder).
See PLAN.md. Standard library only; runs on Python 3.9+.
"""
import argparse
import filecmp
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

BASE = Path(os.path.realpath(__file__)).parent.parent
TEMPLATE = BASE / "templates" / "bindle"
LAYOUT = 1
VERSION = "0.4.5"
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
# Files bindle owns inside every bindle; doctor flags copies that drifted from the template.
MANAGED = ["hooks/lib.sh", "hooks/session-start.sh", "hooks/rules.sh", "hooks/session-end.sh", "hooks/hooks.json"]
# SessionStart hook output is capped at 10,000 characters; leave room for the header line.
RULES_LIMIT = 9000
# Managed files from earlier versions; `bindle upgrade` removes them.
OBSOLETE = ["hooks/print-memory.sh"]
# Layout migrations: {from_layout: function(bindle_root)}, each moving a bindle up one layout.
MIGRATIONS = {}


class BindleError(Exception):
    pass


# ---------- helpers ----------

def read_json(path):
    path = Path(path)
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text() or "{}")
    except json.JSONDecodeError as e:
        raise BindleError(f"{path} isn't valid JSON ({e}); fix it by hand first.")


def write_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def real(path):
    return Path(os.path.realpath(os.path.expanduser(str(path))))


def settings_path(folder):
    return Path(folder) / ".claude" / "settings.local.json"


def load_bindle(path):
    """The bindle at path: its name, marketplace name and paths. Raises if path isn't a bindle."""
    root = real(path)
    meta = read_json(root / "bindle.json")
    if not meta.get("name"):
        raise BindleError(f"{root} isn't a bindle (no bindle.json with a name).")
    market = read_json(root / ".claude-plugin" / "marketplace.json").get("name")
    if not market:
        raise BindleError(f"{root} has no .claude-plugin/marketplace.json name.")
    return {"name": meta["name"], "market": market, "root": root, "memory": root / "memory",
            "layout": meta.get("layout"), "sync": meta.get("sync") is True,
            "audience": meta.get("audience", "private"), "writes": meta.get("writes", "implicit")}


def git(folder, *args):
    r = subprocess.run(["git", "-C", str(folder), *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def check_folder(folder):
    """Claude Code reads settings.local.json at the git repo root, so a folder inside a repo it
    isn't the root of would get its settings written somewhere else."""
    folder = real(folder)
    if not folder.is_dir():
        raise BindleError(f"{folder} isn't a folder.")
    top = git(folder, "rev-parse", "--show-toplevel")
    if top and real(top) != folder:
        raise BindleError(
            f"{folder} is inside the git repo {top}. Claude Code reads settings at the repo root, "
            f"so attach to {top} instead, or to a folder that isn't inside a repo.")
    return folder


def claude(folder, *args):
    exe = os.environ.get("BINDLE_CLAUDE", "claude")
    r = subprocess.run([exe, *args], cwd=str(folder), capture_output=True, text=True)
    if r.returncode != 0:
        raise BindleError(f"`claude {' '.join(args)}` failed:\n{(r.stderr or r.stdout).strip()}")
    return r.stdout


def lock_rules(b):
    """Permission rules that stop a session editing a bindle that's read-only in its folder. `//` makes the
    path absolute; an Edit rule covers every file-writing tool (Claude Code ignores Write(path) rules)."""
    return [f"Edit(/{b['root']}/**)"]


def set_lock(settings, b, locked):
    deny = settings.setdefault("permissions", {}).setdefault("deny", [])
    rules = lock_rules(b)
    if locked:
        deny.extend(r for r in rules if r not in deny)
    else:
        deny[:] = [r for r in deny if r not in rules]
    if not deny:
        del settings["permissions"]["deny"]
    if not settings["permissions"]:
        del settings["permissions"]


def plugin_id(b):
    return f"{b['name']}@{b['market']}"


# ---------- commands ----------

def cmd_new(args):
    name = args.name
    if not NAME_RE.match(name):
        raise BindleError("Name must be lowercase letters, digits and hyphens, e.g. acme or personal.")
    dest = real(args.at) if args.at else Path.cwd() / ".bindle"
    if dest.exists() and any(dest.iterdir()):
        raise BindleError(f"{dest} already exists and isn't empty.")

    for src in sorted(TEMPLATE.rglob("*")):
        rel = src.relative_to(TEMPLATE)
        out = dest / rel
        if src.is_dir():
            out.mkdir(parents=True, exist_ok=True)
            continue
        out.parent.mkdir(parents=True, exist_ok=True)
        if str(rel) in MANAGED:
            shutil.copy2(src, out)  # managed files stay byte-identical to the template
        else:
            out.write_text(src.read_text().replace("{{name}}", name))
            shutil.copymode(src, out)
    meta = read_json(dest / "bindle.json")
    meta.update({"sync": bool(args.sync), "audience": args.audience, "writes": args.writes})
    write_json(dest / "bindle.json", meta)

    excluded = exclude_from_enclosing_repo(dest)
    git(dest, "init", "-q")
    git(dest, "add", "-A")
    committed = git(dest, "commit", "-q", "-m", f"Create the {name} bindle") is not None
    print(f"Created the {name} bindle at {dest}")
    print("  committed" if committed else "  files staged, not committed (no git identity here)")
    print("  no remote set: push it to the domain's own git host when you're ready")
    if excluded:
        print(f"  inside the repo {excluded[0]}: added {excluded[1]} to its .git/info/exclude (local, never committed)")
    print("  sync: " + ("on (memories pull at session start and push at session end, once a remote is set)"
                        if args.sync else "off (turn on with \"sync\": true in bindle.json)"))
    print(f"Turn it on for a folder: bindle attach {dest} <folder> [--writable]")


def cmd_attach(args):
    b = load_bindle(args.bindle)
    folder = check_folder(args.folder or Path.cwd())
    sp = settings_path(folder)
    settings = read_json(sp)

    if args.writable and b["writes"] == "explicit":
        raise BindleError(
            f"{b['name']} takes explicit writes only (things arrive through `bindle collect`), so it can't be "
            f"a folder's writable bindle. Attach it without --writable.")
    if args.writable:
        current = settings.get("autoMemoryDirectory")
        if current and real(current) != real(b["memory"]):
            raise BindleError(
                f"{folder} already writes memories to {current}. A folder has one writable bindle: "
                f"detach that one first, or attach {b['name']} without --writable.")

    if b["market"] not in settings.get("extraKnownMarketplaces", {}):
        claude(folder, "plugin", "marketplace", "add", str(b["root"]), "--scope", "local")
    if not read_json(sp).get("enabledPlugins", {}).get(plugin_id(b)):
        claude(folder, "plugin", "install", plugin_id(b), "--scope", "local")

    settings = read_json(sp)  # claude rewrote it
    if args.writable:
        settings["autoMemoryDirectory"] = str(b["memory"])
        b["memory"].mkdir(exist_ok=True)
    current = settings.get("autoMemoryDirectory")
    writable = bool(current) and real(current) == real(b["memory"])
    # Read-only bindles are locked against edits; the writable one must stay editable for memory writes.
    set_lock(settings, b, locked=not writable)
    write_json(sp, settings)

    print(f"{b['name']} is on in {folder}" + (", and writable" if writable else ", read-only (locked against edits)"))
    print("Takes effect in the next session started from that folder.")


def cmd_detach(args):
    folder = check_folder(args.folder or Path.cwd())
    sp = settings_path(folder)
    settings = read_json(sp)
    b = find_attached(settings, args.bindle)

    if settings.get("enabledPlugins", {}).get(plugin_id(b)):
        claude(folder, "plugin", "uninstall", plugin_id(b), "--scope", "local")
    # The marketplace declaration stays: removing a marketplace is machine-wide in Claude Code.
    settings = read_json(sp)
    current = settings.get("autoMemoryDirectory")
    if current and real(current) == real(b["memory"]):
        del settings["autoMemoryDirectory"]
        print(f"{folder} no longer writes memories to {b['name']}; it uses Claude Code's default memory folder.")
    if settings.get("permissions"):
        set_lock(settings, b, locked=False)
    write_json(sp, settings)
    print(f"{b['name']} is off in {folder}.")


def find_attached(settings, ref):
    """A bindle given by path, or by name among the bindles this folder declares."""
    if Path(os.path.expanduser(ref)).exists():
        return load_bindle(ref)
    for b in declared_bindles(settings):
        if b["name"] == ref:
            return b
    raise BindleError(f"No bindle named {ref} is attached here; pass its path instead.")


def declared_bindles(settings):
    out = []
    for market, entry in settings.get("extraKnownMarketplaces", {}).items():
        source = entry.get("source", {})
        if source.get("source") != "directory" or not source.get("path"):
            continue
        try:
            b = load_bindle(source["path"])
        except BindleError:
            continue
        if b["market"] == market:
            out.append(b)
    return out


def missing_bindles(settings):
    """Local marketplaces this folder declares whose folder is gone, usually a bindle that moved."""
    out = []
    for market, entry in settings.get("extraKnownMarketplaces", {}).items():
        source = entry.get("source", {})
        if source.get("source") == "directory" and source.get("path") and not Path(source["path"]).exists():
            out.append((market, source["path"]))
    return out


def cmd_doctor(args):
    folder = real(args.folder or Path.cwd())
    problems = []
    print(f"Folder: {folder}")

    top = git(folder, "rev-parse", "--show-toplevel")
    if top and real(top) != folder:
        problems.append(f"inside the git repo {top}: Claude Code reads settings from there, not here")

    settings = read_json(settings_path(folder))
    enabled = settings.get("enabledPlugins", {})
    memory_dir = settings.get("autoMemoryDirectory")
    bindles = declared_bindles(settings)
    missing = missing_bindles(settings)
    writable = None
    needs_upgrade = []

    if not bindles and not missing:
        print("  No bindles attached.")
    for market, path in missing:
        state = "was on" if any(k.endswith(f"@{market}") and v for k, v in enabled.items()) else "declared"
        print(f"  {market}: {state}, but nothing is at {path}")
        problems.append(f"{market}: no bindle at {path}. If it moved, attach it again from its new path.")
    if memory_dir and not real(memory_dir).is_dir():
        problems.append(f"memories are set to go to {memory_dir}, which doesn't exist")
    for b in bindles:
        on = bool(enabled.get(plugin_id(b)))
        is_writable = bool(memory_dir) and real(memory_dir) == real(b["memory"])
        writable = b if is_writable else writable
        state = ("on, writable" if is_writable else "on, read-only") if on else "off (declared, not enabled)"
        if b["audience"] != "private" or b["writes"] != "implicit":
            state += f", {b['audience']}, {b['writes']} writes"
        if is_writable and not on:
            problems.append(f"{b['name']} is writable but its plugin isn't enabled")
        memories = len([p for p in b["memory"].glob("*.md") if p.name != "MEMORY.md"]) if b["memory"].is_dir() else 0
        print(f"  {b['name']}: {state}, sync {'on' if b['sync'] else 'off'}")
        print(f"    {b['root']}  ({memories} memories)")
        last = last_sync(b["root"])
        if last:
            print(f"    last sync: {last}")
        for hit in secret_hits(b):
            if hit.startswith("notes/"):
                problems.append(f"{b['name']}: {hit} may hold a secret; move it to secure storage (e.g. a password manager) and leave a pointer in the note")
            else:
                problems.append(f"{b['name']}: {hit} may hold a secret; sync won't push memories until it's removed")
        for line in git_health(b["root"]):
            print(f"    {line}")
        for rel in MANAGED:
            copy = b["root"] / rel
            if not copy.exists():
                problems.append(f"{b['name']}: {rel} is missing")
                needs_upgrade.append(b)
            elif not filecmp.cmp(copy, TEMPLATE / rel, shallow=False):
                problems.append(f"{b['name']}: {rel} differs from bindle's template")
                needs_upgrade.append(b)
        problems.extend(enclosing_repo_problems(b))
        deny = settings.get("permissions", {}).get("deny", [])
        locked = all(r in deny for r in lock_rules(b))
        if on and not is_writable and not locked:
            problems.append(f"{b['name']} is read-only here but not locked against edits; run `bindle attach {b['root']} {folder}` again")
        if is_writable and any(r in deny for r in lock_rules(b)):
            problems.append(f"{b['name']} is writable but locked, so memories can't be saved; run `bindle attach {b['root']} {folder} --writable` again")
        rules = b["root"] / "rules.md"
        if rules.exists() and len(rules.read_text()) > RULES_LIMIT:
            problems.append(f"{b['name']}: rules.md is over {RULES_LIMIT} characters; the session-start hook can show only 10,000")
        if (b["layout"] or 0) < LAYOUT:
            problems.append(f"{b['name']}: layout {b['layout']}, current is {LAYOUT}")
            needs_upgrade.append(b)
        elif b["layout"] > LAYOUT:
            problems.append(f"{b['name']}: layout {b['layout']} is newer than this bindle ({LAYOUT}); git pull bindle")

    if memory_dir and not writable:
        print(f"  Memory: {memory_dir} (not a bindle attached here)")
    elif not memory_dir:
        print("  Memory: Claude Code's default folder (no writable bindle)")

    fixes = []
    for b in {str(b["root"]): b for b in needs_upgrade}.values():
        # Push too when the bindle has a remote, so other machines get the upgrade with their next pull.
        push = f" && git -C {b['root']} push" if git(b["root"], "rev-parse", "--abbrev-ref", "@{upstream}") else ""
        fixes.append(f"bindle upgrade {b['root']}{push}")
    if fixes:
        problems.append("to fix, run (in Claude Code, prefix it with ! so it runs as you; a read-only bindle is locked to Claude):\n      "
                        + "\n      ".join(fixes))
    if problems:
        print("Problems:")
        for p in problems:
            print(f"  - {p}")
        return 1
    print("No problems found.")
    return 0


def enclosing_repo(path):
    """The git repo a path sits inside (not counting a repo at the path itself), and the path relative to it."""
    top = git(Path(path).parent, "rev-parse", "--show-toplevel")
    if not top:
        return None
    return real(top), Path(path).relative_to(real(top)).as_posix()


def exclude_from_enclosing_repo(dest):
    """A bindle inside a project repo would show up as untracked there, and one `git add -A` would push
    private memories into that repo. Exclude it locally (.git/info/exclude), leaving the team's .gitignore alone."""
    found = enclosing_repo(dest)
    if not found:
        return None
    top, rel = found
    if git(top, "check-ignore", "-q", rel + "/") is not None:
        return None  # already ignored
    exclude = Path(git(top, "rev-parse", "--git-path", "info/exclude"))
    exclude = exclude if exclude.is_absolute() else top / exclude
    exclude.parent.mkdir(parents=True, exist_ok=True)
    with exclude.open("a") as f:
        f.write(f"\n# bindle: a private bindle lives here\n/{rel}/\n")
    return top, f"/{rel}/"


def enclosing_repo_problems(b):
    found = enclosing_repo(b["root"])
    if not found:
        return []
    top, rel = found
    if git(top, "ls-files", "--", rel):
        if read_json(b["root"] / "bindle.json").get("demo") is True:
            return []  # a demo bindle is folded into its repo on purpose
        return [f"{b['name']}: tracked by the repo {top}, so its memories get pushed with that repo. "
                f"Remove it from that repo (git rm -r --cached {rel}) and exclude it."]
    if git(top, "check-ignore", "-q", rel + "/") is None:
        return [f"{b['name']}: inside the repo {top} and not ignored there, so `git add -A` would commit it. "
                f"Add /{rel}/ to {top}/.git/info/exclude."]
    return []


def lib(b, script, extra_env=None):
    """Runs bash against the bindle's own hooks/lib.sh, so the CLI and the hooks share one implementation."""
    env = {**os.environ, "CLAUDE_PLUGIN_ROOT": str(b["root"]), **(extra_env or {})}
    return subprocess.run(["bash", "-c", f'. "$CLAUDE_PLUGIN_ROOT/hooks/lib.sh"; {script}'],
                          env=env, capture_output=True, text=True)


def secret_hits(b):
    """Committable files in memory/, outbox/ and notes/ that look like they hold a credential. Files git
    ignores (scratch notes, local query outputs) never leave the machine, so they aren't checked."""
    if not (b["root"] / "hooks" / "lib.sh").exists():
        return []
    files = (git(b["root"], "ls-files", "-co", "--exclude-standard", "--", "memory", "outbox", "notes") or "").splitlines()
    if not files:
        return []
    r = subprocess.run(["bash", "-c", '. "$CLAUDE_PLUGIN_ROOT/hooks/lib.sh"; cd "$root" && secret_hits "$@"', "_", *files],
                       env={**os.environ, "CLAUDE_PLUGIN_ROOT": str(b["root"])}, capture_output=True, text=True)
    return [line for line in r.stdout.splitlines() if line]


def last_sync(root):
    log = Path(root) / ".git" / "bindle-sync.log"
    lines = log.read_text().splitlines() if log.exists() else []
    return lines[-1] if lines else None


def cmd_sync(args):
    folder = real(args.folder or Path.cwd())
    settings = read_json(settings_path(folder))
    enabled = settings.get("enabledPlugins", {})
    bindles = [b for b in declared_bindles(settings) if enabled.get(plugin_id(b))]
    if not bindles:
        print(f"No bindles are on in {folder}.")
        return 0
    for b in bindles:
        # Same steps as the hooks, by hand: pull every bindle that's on; commit and push the writable one.
        r = lib(b, "sync_pull; writable_here && sync_push; true",
                {"CLAUDE_PROJECT_DIR": str(folder), "BINDLE_SYNC_FORCE": "1", "BINDLE_SYNC_LOG": "/dev/stdout"})
        print(f"{b['name']}:")
        for line in (r.stdout + r.stderr).splitlines():
            print(f"  {line.split(' ', 2)[-1] if line[:2] == '20' else line}")
    return 0


def git_health(root):
    if git(root, "rev-parse", "--git-dir") is None:
        return ["not a git repo"]
    lines = []
    dirty = git(root, "status", "--porcelain") or ""
    if dirty:
        lines.append(f"{len(dirty.splitlines())} uncommitted change(s)")
    if not git(root, "remote"):
        lines.append("no remote (local only)")
    else:
        ahead = git(root, "rev-list", "--count", "@{upstream}..HEAD")
        if ahead and ahead != "0":
            lines.append(f"{ahead} commit(s) not pushed")
    return lines


def upgrade_plan(b):
    """What `bindle upgrade` would change in a bindle: managed files that differ or are missing, obsolete
    managed files to remove, and template files the bindle doesn't have yet (never overwriting its own)."""
    root, plan = b["root"], []
    for rel in MANAGED:
        copy = root / rel
        if not copy.exists():
            plan.append(("add", rel))
        elif not filecmp.cmp(copy, TEMPLATE / rel, shallow=False):
            plan.append(("update", rel))
    for rel in OBSOLETE:
        if (root / rel).exists():
            plan.append(("remove", rel))
    for src in sorted(TEMPLATE.rglob("*")):
        rel = src.relative_to(TEMPLATE).as_posix()
        if src.is_file() and rel not in MANAGED and not (root / rel).exists():
            plan.append(("add", rel))
    # A bindle's .gitignore is its own, so upgrade only appends template rules it lacks.
    own = (root / ".gitignore").read_text().splitlines() if (root / ".gitignore").exists() else []
    missing = [l for l in (TEMPLATE / ".gitignore").read_text().splitlines()
               if l.strip() and not l.startswith("#") and l not in own]
    if missing and (root / ".gitignore").exists():
        plan.append(("ignore", ", ".join(missing)))
    return plan


def cmd_upgrade(args):
    if args.bindle:
        bindles = [load_bindle(args.bindle)]
    else:
        folder = real(Path.cwd())
        bindles = declared_bindles(read_json(settings_path(folder)))
        if not bindles:
            raise BindleError(f"No bindles are attached to {folder}; pass a bindle's path.")
    for b in bindles:
        layout = b["layout"] or 0
        if layout > LAYOUT:
            raise BindleError(f"{b['name']} has layout {layout}, newer than this bindle ({LAYOUT}). git pull bindle first.")
        plan = upgrade_plan(b)
        steps = [f"migrate layout {n} -> {n + 1}" for n in range(layout, LAYOUT)]
        if not plan and not steps:
            print(f"{b['name']}: up to date (bindle {VERSION})")
            continue
        print(f"{b['name']}: {'would change' if args.dry_run else 'upgrading'} ({b['root']})")
        for line in steps + [f"{action} {rel}" for action, rel in plan]:
            print(f"  {line}")
        if args.dry_run:
            continue
        for n in range(layout, LAYOUT):
            MIGRATIONS[n](b["root"])
        touched = []
        for action, rel in plan:
            out = b["root"] / rel
            if action == "ignore":
                lines = [l for l in (TEMPLATE / ".gitignore").read_text().splitlines()
                         if l.strip() and not l.startswith("#") and l not in (b["root"] / ".gitignore").read_text().splitlines()]
                with (b["root"] / ".gitignore").open("a") as f:
                    f.write("\n# Added by bindle upgrade\n" + "\n".join(lines) + "\n")
                touched.append(".gitignore")
                continue
            if action == "remove":
                out.unlink()
            elif rel in MANAGED:
                out.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(TEMPLATE / rel, out)
            else:
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_text((TEMPLATE / rel).read_text().replace("{{name}}", b["name"]))
                shutil.copymode(TEMPLATE / rel, out)
            touched.append(rel)
        if steps:
            meta = read_json(b["root"] / "bindle.json")
            meta["layout"] = LAYOUT
            write_json(b["root"] / "bindle.json", meta)
            touched.append("bindle.json")
        # Commit only what upgrade touched, so a person's own uncommitted work stays theirs.
        git(b["root"], "add", "-A", "--", *touched)
        if git(b["root"], "commit", "-q", "-m", f"Upgrade bindle files to bindle {VERSION}", "--", *touched) is not None:
            print(f"  committed (push when ready; sync pushes only memory/)")
        else:
            print("  changed, not committed (no git identity here?)")
    return 0


# ---------- promotion: outbox and collect ----------

KINDS = {"memory": "memory", "skill": "skills", "command": "commands"}
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")


def private_terms(b):
    """Words that identify the bindle's domain; anything leaving the bindle is checked against them."""
    f = b["root"] / "private-terms.txt"
    if not f.exists():
        return []
    return [t.strip() for t in f.read_text().splitlines() if t.strip() and not t.strip().startswith("#")]


def leak_hits(b, paths):
    """(file, term) pairs where a draft names the source domain, plus files that look like they hold a secret."""
    hits = []
    terms = private_terms(b)
    files = [f for p in paths for f in ([p] if Path(p).is_file() else sorted(Path(p).rglob("*"))) if Path(f).is_file()]
    for f in files:
        text = Path(f).read_text(errors="ignore")
        for t in terms:
            # Whole words, except a term ending in punctuation (a ticket prefix like "ACME-") matches what follows it.
            start = r"(?<![A-Za-z0-9])" if t[0].isalnum() else ""
            end = r"(?![A-Za-z0-9])" if t[-1].isalnum() else ""
            if re.search(start + re.escape(t) + end, text, re.I):
                hits.append((str(f), t))
    env = {**os.environ, "CLAUDE_PLUGIN_ROOT": str(b["root"])}
    out = subprocess.run(["bash", "-c", '. "$CLAUDE_PLUGIN_ROOT/hooks/lib.sh"; secret_hits "$@"', "_", *map(str, files)],
                         env=env, capture_output=True, text=True).stdout
    hits += [(line, "possible secret") for line in out.splitlines() if line]
    return hits


def outbox_items(b):
    box = b["root"] / "outbox"
    items = []
    for meta_file in sorted(box.glob("*/item.json")) if box.is_dir() else []:
        items.append({**read_json(meta_file), "dir": meta_file.parent, "slug": meta_file.parent.name})
    return items


def cmd_outbox_add(args):
    b = load_bindle(args.bindle)
    slug = args.name
    if not SLUG_RE.match(slug):
        raise BindleError("Name must be lowercase letters, digits, hyphens or underscores.")
    src = Path(args.path)
    if not src.exists():
        raise BindleError(f"{src} doesn't exist.")
    if args.kind == "memory" and not src.is_file():
        raise BindleError("A memory is a single .md file.")
    if args.kind == "skill" and not (src / "SKILL.md").is_file():
        raise BindleError("A skill is a folder with a SKILL.md.")
    hits = leak_hits(b, [src])
    if hits:
        raise BindleError("Not added; the draft still names this domain or looks like it holds a secret:\n"
                          + "\n".join(f"  {f}: {t}" for f, t in hits))
    dest = b["root"] / "outbox" / slug
    if dest.exists():
        raise BindleError(f"{dest} already exists; pick another name.")
    dest.mkdir(parents=True)
    target_name = "memory.md" if args.kind == "memory" else src.name
    if src.is_dir():
        shutil.copytree(src, dest / target_name)
    else:
        shutil.copy2(src, dest / target_name)
    write_json(dest / "item.json", {"kind": args.kind, "file": target_name, "description": args.description,
                                    "status": "approved", "collected_into": []})
    git(b["root"], "add", "--", f"outbox/{slug}")
    git(b["root"], "commit", "-q", "-m", f"Outbox: {slug}", "--", f"outbox/{slug}")
    print(f"Added {args.kind} {slug} to {b['name']}'s outbox (leak check and secret check passed).")
    print(f"Collect it: bindle collect {b['root']} --into <target bindle> --items {slug}")


def cmd_outbox_list(args):
    b = load_bindle(args.bindle)
    items = outbox_items(b)
    if not items:
        print(f"{b['name']}'s outbox is empty.")
    for it in items:
        where = f" -> {', '.join(it['collected_into'])}" if it["collected_into"] else ""
        print(f"  {it['slug']}: {it['kind']}, {it['status']}{where}. {it.get('description') or ''}")


def cmd_collect(args):
    source, target = load_bindle(args.source), load_bindle(args.into)
    if source["root"] == target["root"]:
        raise BindleError("Source and target are the same bindle.")
    items = {it["slug"]: it for it in outbox_items(source)}
    wanted = list(items) if args.all else [s.strip() for s in (args.items or "").split(",") if s.strip()]
    if not wanted:
        raise BindleError("Name the items (--items a,b) or pass --all, so the command shows exactly what moves.")
    unknown = [s for s in wanted if s not in items]
    if unknown:
        raise BindleError(f"Not in {source['name']}'s outbox: {', '.join(unknown)}")
    todo = [items[s] for s in wanted if target["name"] not in items[s]["collected_into"]]
    if not todo:
        print(f"Nothing to collect: already in {target['name']}.")
        return 0

    # Recheck at the moment of crossing: the outbox may have been edited since it was approved.
    hits = leak_hits(source, [it["dir"] / it["file"] for it in todo])
    if hits:
        raise BindleError("Nothing collected; an item names the source domain or looks like it holds a secret:\n"
                          + "\n".join(f"  {f}: {t}" for f, t in hits))
    for it in todo:
        out = target["root"] / KINDS[it["kind"]] / (f"{it['slug']}.md" if it["kind"] in ("memory", "command") else it["file"])
        if out.exists():
            raise BindleError(f"{out} already exists in {target['name']}; nothing collected.")

    moved = []
    for it in todo:
        src = it["dir"] / it["file"]
        if it["kind"] == "skill":
            out = target["root"] / "skills" / it["file"]
            shutil.copytree(src, out)
        else:
            out = target["root"] / KINDS[it["kind"]] / f"{it['slug']}.md"
            out.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, out)
        if it["kind"] == "memory":
            index = target["root"] / "memory" / "MEMORY.md"
            line = f"- [{it['slug']}]({it['slug']}.md) — {it.get('description') or 'promoted from ' + source['name']}\n"
            with index.open("a") as f:
                f.write(line)
        moved.append(str(out.relative_to(target["root"])))
        meta = read_json(it["dir"] / "item.json")
        meta["status"] = "collected"
        meta["collected_into"] = sorted(set(meta["collected_into"]) | {target["name"]})
        write_json(it["dir"] / "item.json", meta)

    names = ", ".join(it["slug"] for it in todo)
    paths = moved + (["memory/MEMORY.md"] if any(it["kind"] == "memory" for it in todo) else [])
    git(target["root"], "add", "--", *paths)
    git(target["root"], "commit", "-q", "-m", f"Promote from {source['name']}: {names}", "--", *paths)
    git(source["root"], "add", "--", "outbox")
    git(source["root"], "commit", "-q", "-m", f"Outbox: collected into {target['name']}: {names}", "--", "outbox")
    print(f"Collected into {target['name']}: " + ", ".join(moved))
    print(f"Committed in both bindles. Sync pushes memory/ and outbox/; push {target['name']} yourself if it got a skill or command.")
    return 0


def cmd_install(args):
    """Puts the bindle command on PATH and links its /bindle command into ~/.claude. Nothing else:
    bindle never takes over ~/.claude's settings or CLAUDE.md."""
    bindir = Path.home() / ".local" / "bin"
    links = [(bindir / "bindle", BASE / "bin" / "bindle"),
             (Path.home() / ".claude" / "commands" / "bindle.md", BASE / "global" / "commands" / "bindle.md"),
             (Path.home() / ".claude" / "skills" / "bindle-promote", BASE / "global" / "skills" / "bindle-promote")]
    for link, target in links:
        if link.exists() and not link.is_symlink():
            raise BindleError(f"{link} exists and isn't a symlink; move it aside first.")
    for link, target in links:
        link.parent.mkdir(parents=True, exist_ok=True)
        if link.is_symlink():
            link.unlink()
        link.symlink_to(target)
        print(f"Linked {link} -> {target}")
    if str(bindir) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f'Add {bindir} to PATH: export PATH="$HOME/.local/bin:$PATH"')


def main(argv=None):
    p = argparse.ArgumentParser(prog="bindle", description="Create bindles and turn them on for folders.")
    p.add_argument("--version", action="version", version=f"bindle {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("install", help="link bindle onto PATH and /bindle into ~/.claude/commands")
    s.set_defaults(fn=cmd_install)

    s = sub.add_parser("new", help="create a bindle repo")
    s.add_argument("name")
    s.add_argument("--at", help="where to create it (default: ./.bindle)")
    s.add_argument("--sync", action="store_true", help="sync memories with the bindle's remote at session start and end")
    s.add_argument("--audience", choices=["private", "shared", "public"], default="private", help="who can see it (default: private)")
    s.add_argument("--writes", choices=["implicit", "explicit"], default="implicit",
                   help="implicit: can be a folder's writable bindle; explicit: only `bindle collect` adds to it")
    s.set_defaults(fn=cmd_new)

    s = sub.add_parser("outbox", help="a bindle's outbox: reviewed, general items waiting to be promoted")
    osub = s.add_subparsers(dest="outbox_cmd", required=True)
    o = osub.add_parser("add", help="add an approved draft (after a leak check and secret check)")
    o.add_argument("bindle", help="the source bindle")
    o.add_argument("path", help="the draft: a memory .md file, or a skill folder")
    o.add_argument("--kind", choices=list(KINDS), default="memory")
    o.add_argument("--name", required=True, help="the item's slug, e.g. small-prs")
    o.add_argument("--description", default="", help="one line for the target's index")
    o.set_defaults(fn=cmd_outbox_add)
    o = osub.add_parser("list", help="show the outbox")
    o.add_argument("bindle")
    o.set_defaults(fn=cmd_outbox_list)

    s = sub.add_parser("collect", help="move approved outbox items into another bindle")
    s.add_argument("source", help="the bindle whose outbox to collect from")
    s.add_argument("--into", required=True, help="the target bindle")
    s.add_argument("--items", help="comma-separated item names")
    s.add_argument("--all", action="store_true", help="every item not yet in the target")
    s.set_defaults(fn=cmd_collect)

    s = sub.add_parser("attach", help="turn a bindle on for the folder you launch Claude from",
                       description="Turn a bindle on for a folder: sessions started from that folder load the bindle. Writes the folder's .claude/settings.local.json; nothing is copied or linked.")
    s.add_argument("bindle", help="path to the bindle repo")
    s.add_argument("folder", nargs="?", help="the folder you launch Claude from (default: here)")
    s.add_argument("--writable", action="store_true", help="new memories in this folder go to this bindle")
    s.set_defaults(fn=cmd_attach)

    s = sub.add_parser("detach", help="turn a bindle off for a folder")
    s.add_argument("bindle", help="the bindle's name or path")
    s.add_argument("folder", nargs="?", help="the folder you launch Claude from (default: here)")
    s.set_defaults(fn=cmd_detach)

    s = sub.add_parser("upgrade", help="bring a bindle's managed files and layout up to this bindle version")
    s.add_argument("bindle", nargs="?", help="path to the bindle (default: every bindle attached to this folder)")
    s.add_argument("--dry-run", action="store_true", help="show what would change")
    s.set_defaults(fn=cmd_upgrade)

    s = sub.add_parser("sync", help="pull the bindles that are on, and commit and push the writable one's memories")
    s.add_argument("folder", nargs="?", help="the folder you launch Claude from (default: here)")
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser("doctor", help="show what's on in a folder and any problems")
    s.add_argument("folder", nargs="?", help="the folder you launch Claude from (default: here)")
    s.set_defaults(fn=cmd_doctor)

    args = p.parse_args(argv)
    try:
        return args.fn(args) or 0
    except BindleError as e:
        print(f"bindle: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
